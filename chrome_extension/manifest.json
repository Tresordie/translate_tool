{
  "manifest_version": 3,
  "name": "AI Tool Box - AI 智能翻译",
  "version": "0.25.8",
  "description": "基于大模型 API 的浏览器翻译插件，支持划词翻译、Side Panel 侧边栏和 30+ 语言互译",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "打开 AI Tool Box 侧边栏"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fullpage.html",
        "fullpage.js",
        "workreport.html",
        "workreport.js",
        "todolist.html",
        "todolist.js",
        "english_learning.html",
        "english_learning.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
